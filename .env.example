# Public site URL, used for canonical URLs, sitemap and Open Graph.
SITE_URL=http://localhost:4321
# production | preview. Anything but production sends noindex.
PUBLIC_SITE_ENV=preview

# Keystatic GitHub mode (production). Local mode needs none of these.
PUBLIC_KEYSTATIC_GITHUB_REPO=Pramoj123/kab_marketting
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
