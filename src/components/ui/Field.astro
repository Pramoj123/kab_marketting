---
import { field, type FieldVariants } from './form.variants';

interface Props extends FieldVariants {
  label: string;
  name: string;
  options?: readonly string[];
  required?: boolean;
  placeholder?: string;
  hint?: string;
  /** Shown under the field when it is required and left empty. */
  errorMessage?: string;
}

const {
  label,
  name,
  kind = 'text',
  options = [],
  required = false,
  placeholder,
  hint,
  errorMessage = `Please fill in ${label.toLowerCase()}.`,
} = Astro.props;
const id = `field-${name}`;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
// The error joins aria-describedby only while it shows (the form script adds it), so it is not read out early.
const describedBy = hint ? hintId : undefined;
const classes = field({ kind });
const control = { id, name, required, 'aria-describedby': describedBy, class: classes.control() };
---

<div class={classes.root()}>
  <label for={id} class={classes.label()}>
    {label}
    {!required && <span class={classes.optional()}>(optional)</span>}
  </label>
  {kind === 'textarea' ? (
    <textarea {...control} rows={4} placeholder={placeholder} />
  ) : kind === 'select' ? (
    <select {...control}>
      <option value="">Choose one</option>
      {options.map((option) => (
        <option value={option}>{option}</option>
      ))}
    </select>
  ) : (
    <input {...control} type={kind} placeholder={placeholder} />
  )}
  {hint && (
    <p id={hintId} class={classes.hint()}>
      {hint}
    </p>
  )}
  {required && (
    <p id={errorId} class={classes.error()} data-error hidden>
      {errorMessage}
    </p>
  )}
</div>
