---
import { grid, type GridVariants } from './layout.variants';

interface Props extends GridVariants {
  /** Children rise in one after another as the grid scrolls into view. */
  stagger?: boolean;
  class?: string;
}

const { columns, stagger = false, class: className } = Astro.props;
---

<div class={grid({ columns, class: className })} data-stagger={stagger ? '' : undefined}>
  <slot />
</div>
