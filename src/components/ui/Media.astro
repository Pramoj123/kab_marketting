---
import { media, type MediaVariants } from './surface.variants';

interface Props {
  src: string;
  alt: string;
  /** eager for the first-screen image, so it is not loaded late. */
  loading?: 'lazy' | 'eager';
  shape?: MediaVariants['shape'];
  class?: string;
}

const { src, alt, loading = 'lazy', shape, class: className } = Astro.props;
---

<img
  src={src}
  alt={alt}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  decoding="async"
  class={media({ shape, class: className })}
/>
