---
import { navLink, type NavLinkVariants } from './surface.variants';

interface Props extends Pick<NavLinkVariants, 'tone'> {
  href: string;
  current?: boolean;
}

const { href, current = false, tone } = Astro.props;
---

<a href={href} aria-current={current ? 'page' : undefined} class={navLink({ current, tone })}>
  <slot />
</a>
