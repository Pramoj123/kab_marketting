---
import { stack, type StackVariants } from './layout.variants';

interface Props extends StackVariants {
  class?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { gap, align, width, class: className, ...attributes } = Astro.props;
---

<div class={stack({ gap, align, width, class: className })} {...attributes}>
  <slot />
</div>
