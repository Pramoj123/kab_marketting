---
import { Button, Container, Logo, MenuSheet, NavLink } from '@/components/ui';
import { shell } from '@/components/ui/shell.variants';
import { orderAction } from '@/lib/actions';
import { getFooterNavigation, getPrimaryNavigation } from '@/lib/navigation';
import { getSiteSettings } from '@/lib/site';

interface Props {
  siteName: string;
  currentPath: string;
}

const { siteName, currentPath } = Astro.props;
const [primary, secondary, site] = await Promise.all([
  getPrimaryNavigation(),
  getFooterNavigation(),
  getSiteSettings(),
]);
// The order button and phone menu action appear once WhatsApp ordering is switched on.
const action = orderAction(site.whatsappNumber);
const styles = shell();
---

<a href="#main" class={styles.skip()}>
  Skip to content
</a>
<header class={styles.header()}>
  <Container>
    <div class={styles.bar()}>
      <Logo siteName={siteName} src={site.logo} />
      <nav aria-label="Primary" class={styles.nav()}>
        {primary.map((item) => (
          <NavLink href={item.href} current={currentPath === item.href}>
            {item.label}
          </NavLink>
        ))}
      </nav>
      <div class={styles.end()}>
        {action && (
          <Button href={action.href} size="sm" class={styles.headerAction()}>
            {action.label}
          </Button>
        )}
        <MenuSheet
          siteName={siteName}
          primary={primary}
          secondary={secondary}
          secondaryLabel="Menu by category"
          currentPath={currentPath}
          logo={site.logo}
          action={action}
        />
      </div>
    </div>
  </Container>
</header>
