---
import { ActionBar, Button, Container, Heading, NavLink, Text, TextLink } from '@/components/ui';
import { footer } from '@/components/ui/shell.variants';
import { mainAction, orderAction } from '@/lib/actions';
import { instagramProfile } from '@/lib/contact';
import { getFooterNavigation, getPrimaryNavigation } from '@/lib/navigation';
import { getSiteSettings } from '@/lib/site';

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const year = new Date().getFullYear();
const [categories, help, site] = await Promise.all([
  getFooterNavigation(),
  getPrimaryNavigation(),
  getSiteSettings(),
]);
const action = mainAction(site.whatsappNumber);
const instagram = instagramProfile(site.socialProfiles);
const columns = [
  { title: 'Menu', links: categories },
  { title: 'Help', links: help },
  { title: 'Follow', links: instagram ? [{ label: 'Instagram', href: instagram }] : [] },
].filter((column) => column.links.length > 0);
const styles = footer();
const order = orderAction(site.whatsappNumber);
---

<footer class={styles.root()}>
  <Container>
    <div class={styles.close()}>
      <Heading tone="inverse">Homemade bakes, delivered across Chennai</Heading>
      <Button href={action.href} size="lg">
        {action.label}
      </Button>
    </div>
    <div class={styles.columns()}>
      {columns.map((column) => (
        <nav aria-label={column.title} class={styles.column()}>
          <p class={styles.title()}>{column.title}</p>
          {column.links.map((link) => (
            <NavLink href={link.href} tone="inverse">
              {link.label}
            </NavLink>
          ))}
        </nav>
      ))}
    </div>
    <div class={styles.legal()}>
      {site.allergenNotice && (
        <Text size="small" tone="inverse">
          {site.allergenNotice}
        </Text>
      )}
      <Text size="small" measure={false} tone="inverse">
        {`© ${year} ${siteName}`} ·{' '}
        <TextLink href="/photo-credits/" tone="inverse">
          Photo credits
        </TextLink>
      </Text>
    </div>
  </Container>
</footer>
{order && <ActionBar action={order} />}
