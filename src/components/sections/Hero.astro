---
import { Banner, Section } from '@/components/ui';
import type { HeroProps } from '@/cms/schemas';
import { resolveActions } from '@/lib/actions';
import { getSiteSettings } from '@/lib/site';
import HeroWords from './HeroWords.astro';

type Props = HeroProps;

const { notice, headline, subheadline, primaryCta, secondaryCta, image, size } = Astro.props;
const site = await getSiteSettings();
const words = {
  notice,
  headline,
  subheadline,
  actions: resolveActions([primaryCta, secondaryCta], site.whatsappNumber),
  full: size === 'full',
  onPhoto: Boolean(image),
};
---

{image ? (
  <Banner image={image} size={words.full ? 'full' : 'compact'}>
    <HeroWords {...words} />
  </Banner>
) : (
  <Section tone="aurora" space="compact" reveal={false}>
    <HeroWords {...words} />
  </Section>
)}
