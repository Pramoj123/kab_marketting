---
import {
  Aside,
  Button,
  Card,
  Container,
  Field,
  Fieldset,
  Grid,
  Heading,
  Panel,
  Section,
  Stack,
  Text,
} from '@/components/ui';
import type { CustomOrderProps } from '@/cms/schemas';
import { CUSTOM_ORDER_TYPES } from '@/cms/product-options';
import { ENQUIRY_MESSAGE } from '@/lib/contact';
import { CUSTOM_ORDER_FORM_ID, getSiteSettings } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';

type Props = CustomOrderProps;

const { heading, intro, note } = Astro.props;
const site = await getSiteSettings();
const chat = whatsappLink(site.whatsappNumber, ENQUIRY_MESSAGE);
---

<Section id={CUSTOM_ORDER_FORM_ID}>
  <Container>
    <Aside>
      <Fragment slot="side">
        <Heading>{heading}</Heading>
        {intro && <Text size="lead">{intro}</Text>}
        {note && <Text tone="muted">{note}</Text>}
        {chat && (
          <Panel size="sm">
            <Stack>
              <Text tone="inverse">Prefer to talk it through first?</Text>
              <Button href={chat} intent="glass">
                Message us on WhatsApp
              </Button>
            </Stack>
          </Panel>
        )}
      </Fragment>
      <Card size="lg">
        <form data-custom-order data-phone={site.whatsappNumber} novalidate class="w-full">
          <Stack gap="lg">
            <Fieldset legend="Your order">
              <Grid columns={2}>
                <Field
                  name="product"
                  label="What would you like?"
                  kind="select"
                  options={CUSTOM_ORDER_TYPES}
                  required
                  errorMessage="Choose what you would like us to make."
                />
                <Field
                  name="date"
                  label="Needed on"
                  kind="date"
                  required
                  hint="Most bakes need a day's notice, bento cakes two days."
                  errorMessage="Choose a date from tomorrow onwards."
                />
                <Field name="flavour" label="Flavour" />
                <Field
                  name="size"
                  label="Size or quantity"
                  placeholder="Box of 6, 1 cake, 40 boxes"
                />
              </Grid>
            </Fieldset>
            <Fieldset legend="Occasion and message">
              <Grid columns={2}>
                <Field name="name" label="Your name" />
                <Field
                  name="occasion"
                  label="Occasion"
                  placeholder="Birthday, anniversary, office party"
                />
              </Grid>
              <Field name="message" label="Message on the cake or card" kind="textarea" />
              <Field name="notes" label="Anything else we should know" kind="textarea" />
            </Fieldset>
            <Stack gap="sm">
              <Button type="submit" size="lg">
                Send on WhatsApp
              </Button>
              <div role="status" aria-live="polite" data-status class="text-small text-ink"></div>
            </Stack>
          </Stack>
        </form>
      </Card>
    </Aside>
  </Container>
</Section>

<script>
  import { customOrderMessage, whatsappLink, type CustomOrderBrief } from '@/lib/whatsapp';

  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-custom-order]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const date = form?.querySelector<HTMLInputElement>('input[name="date"]');

  // Earliest date is tomorrow, in the visitor's own time zone.
  if (date) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setMinutes(tomorrow.getMinutes() - tomorrow.getTimezoneOffset());
    date.min = tomorrow.toISOString().slice(0, 10);
  }

  /** Shows or hides a field's error, and links it to the field only while it shows. */
  function setError(control: Control, invalid: boolean) {
    const error = document.getElementById(`${control.id}-error`);
    const described = (control.getAttribute('aria-describedby') ?? '')
      .split(' ')
      .filter((id) => id && id !== error?.id);
    if (invalid && error) described.push(error.id);
    if (described.length > 0) control.setAttribute('aria-describedby', described.join(' '));
    else control.removeAttribute('aria-describedby');
    if (invalid) control.setAttribute('aria-invalid', 'true');
    else control.removeAttribute('aria-invalid');
    if (error) error.hidden = !invalid;
  }

  // Empty, or out of range (a date before tomorrow). Validity still works under novalidate.
  const isInvalid = (control: Control) => !control.value.trim() || !control.validity.valid;

  /** Marks each invalid required field and returns the first one, or null when all are fine. */
  function firstInvalid(fields: Control[]) {
    let first: Control | null = null;
    for (const control of fields) {
      const invalid = isInvalid(control);
      setError(control, invalid);
      if (invalid && !first) first = control;
    }
    return first;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const required = [...form.querySelectorAll<Control>('[required]')];
    const invalid = firstInvalid(required);
    if (invalid) {
      invalid.focus();
      return;
    }
    const brief = Object.fromEntries(new FormData(form)) as CustomOrderBrief;
    const link = whatsappLink(form.dataset.phone ?? '', customOrderMessage(brief));
    if (!status) return;
    if (!link) {
      status.textContent = 'WhatsApp ordering is not switched on yet. Please check back soon.';
      return;
    }
    status.textContent = 'Opening WhatsApp. Send the message there to place your request.';
    window.open(link, '_blank', 'noopener,noreferrer');
  });

  // Clear a field's error as soon as it is filled in.
  form?.addEventListener('input', (event) => {
    const control = event.target as Control;
    if (control.required && !isInvalid(control)) setError(control, false);
  });
</script>
