---
import { Container, DefinitionList, Heading, Section, Stack } from '@/components/ui';
import type { FaqProps } from '@/cms/schemas';

type Props = FaqProps;

const { heading, items } = Astro.props;
// Answers are shown in full: people scan them, and nothing is hidden behind a click.
const rows = items.map((item) => ({ term: item.question, detail: item.answer }));
---

<Section tone="blush">
  <Container>
    <Stack gap="lg" width="narrow">
      <Heading>{heading}</Heading>
      <DefinitionList items={rows} />
    </Stack>
  </Container>
</Section>
