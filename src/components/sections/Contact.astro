---
import { Button, Container, Heading, Panel, Row, Section, Stack, Text } from '@/components/ui';
import type { ContactProps } from '@/cms/schemas';
import { ENQUIRY_MESSAGE, instagramProfile } from '@/lib/contact';
import { getSiteSettings } from '@/lib/site';
import { whatsappLink } from '@/lib/whatsapp';

type Props = ContactProps;

const { heading, intro, hours } = Astro.props;
const site = await getSiteSettings();
const whatsapp = whatsappLink(site.whatsappNumber, ENQUIRY_MESSAGE);
const instagram = instagramProfile(site.socialProfiles);
---

<Section>
  <Container>
    <Panel>
      <Stack gap="lg">
        <Heading tone="inverse">{heading}</Heading>
        {intro && (
          <Text size="lead" tone="inverse">
            {intro}
          </Text>
        )}
        {(whatsapp || instagram) && (
          <Row>
            {whatsapp && (
              <Button href={whatsapp} size="lg">
                Message us on WhatsApp
              </Button>
            )}
            {instagram && (
              <Button href={instagram} intent="glass" size="lg">
                Follow on Instagram
              </Button>
            )}
          </Row>
        )}
        {hours && (
          <Text size="small" tone="inverse">
            {hours}
          </Text>
        )}
      </Stack>
    </Panel>
  </Container>
</Section>
