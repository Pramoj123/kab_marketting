---
import { Container, Heading, Section, Stack, StepList, Text } from '@/components/ui';
import type { StepsProps } from '@/cms/schemas';

type Props = StepsProps;

const { heading, intro, items } = Astro.props;
---

<Section tone="ink">
  <Container>
    <Stack gap="lg">
      <Stack>
        <Heading tone="inverse">{heading}</Heading>
        {intro && (
          <Text size="lead" tone="inverse">
            {intro}
          </Text>
        )}
      </Stack>
      <StepList items={items} tone="inverse" stagger />
    </Stack>
  </Container>
</Section>
