---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Reveal from '@/components/layout/Reveal.astro';
import Seo from '@/components/layout/Seo.astro';
import type { SeoData } from '@/lib/seo';

interface Props {
  seo: SeoData;
  siteName: string;
  path: string;
}

const { seo, siteName, path } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Scroll reveal hides content only when scripts run. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Font cssVariable="--font-instrument-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-instrument-sans" preload />
    <Seo seo={seo} />
  </head>
  <body>
    <Header siteName={siteName} currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <Footer siteName={siteName} />
    <Reveal />
  </body>
</html>
