---
import { Banner } from '@/components/ui';
import HeroWords from '@/components/sections/HeroWords.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildSeo } from '@/lib/seo';
import { getSiteSettings } from '@/lib/site';

const site = await getSiteSettings();
const seo = buildSeo({
  site,
  page: {
    title: 'Page not found',
    seo: { title: '', description: '', noindex: true, schemaType: 'WebPage' },
    blocks: [],
  },
  path: '/404/',
  siteUrl: Astro.site?.toString() ?? 'http://localhost:4321',
  isProduction: false,
});
---

<BaseLayout seo={seo} siteName={site.siteName} path="/404/">
  <Banner image="/images/hero/brownie-chunks.jpg" size="full">
    <HeroWords
      notice="Error 404"
      headline="This page is not on the menu"
      subheadline="The link may be old or mistyped. Everything we bake is one tap away."
      actions={[
        { label: 'See the menu', href: '/menu/' },
        { label: 'Back to home', href: '/' },
      ]}
      full={false}
      onPhoto
    />
  </Banner>
</BaseLayout>
